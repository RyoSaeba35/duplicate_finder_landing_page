6:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Duplicate Finder\",\"operatingSystem\":\"Windows\",\"applicationCategory\":\"UtilitiesApplication\",\"description\":\"任意のフォルダーやドライブをスキャンし、重複ファイルをライブプレビュー付きで比較して、安全にごみ箱に移動できます。買い切り15ユーロ、14日間無料体験。\",\"url\":\"https://www.getduplicatefinder.app/ja\",\"offers\":{\"@type\":\"Offer\",\"price\":\"15\",\"priceCurrency\":\"EUR\",\"url\":\"https://pierrecode.gumroad.com/l/byzsj\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"本当に必要なファイルが削除されませんか？\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"明示的にマークしたファイルのみが、並べて比較した後にのみ削除されます。一致するファイルはファイル内容のハッシュ値によって判定されるため、バイト単位で完全に一致する重複ファイルのみが表示されます。また、削除は常にごみ箱への移動であり、完全な削除ではありません。\"}},{\"@type\":\"Question\",\"name\":\"Mac や Linux でも使えますか？\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"現時点では対応していません — Duplicate Finder は現在 Windows 専用です。\"}},{\"@type\":\"Question\",\"name\":\"14日間の無料体験が終わるとどうなりますか？\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"ライセンスキーを入力するまでスキャン機能がロックされます。体験期間中のデータや設定は失われず、キーを有効化すると再びロックが解除されます。\"}},{\"@type\":\"Question\",\"name\":\"インストール時に Windows で警告が表示されるのはなぜですか？\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"このアプリはまだ有料のコード署名証明書で署名されていないためです。多くの個人開発者は初めての売上を得るまでこのステップを省略します。Windows はソフトウェアの安全性に関わらず、未確認の発行元にはこのように警告を表示します。これはこのアプリ特有の問題ではありません。続行するには「詳細情報」をクリックし、「実行」を選択してください。インストール前に動作を確認したい場合は、ソースコードを GitHub で公開しています。\"}}]}"}}],[["$","header",null,{"className":"header","children":["$","div",null,{"className":"header__inner","children":[["$","div",null,{"className":"brand","children":[["$","img",null,{"src":"/logo.png","width":22,"height":22,"alt":"","aria-hidden":"true"}],"Duplicate Finder"]}],["$","nav",null,{"className":"nav","children":[["$","div",null,{"className":