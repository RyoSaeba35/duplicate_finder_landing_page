4:["$","section","Name-based search isn't enough",{"className":"seo-page__section","children":[["$","h2",null,{"children":"Name-based search isn't enough"}],["$","p",null,{"children":"Your camera saves \"IMG_0042.JPG\" but your phone backup saves the same photo as \"2024-03-15_14-22-01.jpg\". These are identical files with completely different names. Only a content-based comparison — hashing actual image data byte-by-byte — catches them reliably."}]]}]
5:["$","ol",null,{"className":"seo-page__steps","children":[["$","li","0",{"children":[["$","h3",null,{"children":"Point it at your photo folders"}],["$","p",null,{"children":"Select your Pictures folder, camera import folder, or any location where photos accumulate. Duplicate Finder scans every image regardless of filename."}]]}],["$","li","1",{"children":[["$","h3",null,{"children":"Compare photos side by side"}],["$","p",null,{"children":"For every duplicate group, you see both images with a live preview, file size, location, and modification date. You see exactly what you're keeping and what you're removing."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Remove copies safely"}],["$","p",null,{"children":"Selected duplicates go to the Windows Recycle Bin — nothing is permanently deleted. If you change your mind, the originals are still there."}]]}]]}]
6:["$","section",null,{"className":"seo-page__faq","children":[["$","h2",null,{"children":"Frequently asked questions"}],[["$","div","Does it preview RAW photo files?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"Does it preview RAW photo files?"}],["$","p",null,{"children":"Duplicate Finder previews JPEG, PNG, and common image formats. RAW files (CR2, NEF, ARW) are detected as duplicates by content hash but may not display a preview — the file comparison still works correctly."}]]}],["$","div","What if I have the same photo in different resolutions?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"What if I have the same photo in different resolutions?"}],["$","p",null,{"children":"Different resolutions are different files — Duplicate Finder won't flag them as duplicates because the content is technically different. It only matches byte-for-byte identical files."}]]}],["$","div","Can I scan my phone if it's connected via USB?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"Can I scan my phone if it's connected via USB?"}],["$","p",null,{"children":"Yes, if Windows mounts your phone as a drive accessible in Windows Explorer, Duplicate Finder can scan it."}]]}]]]}]
