4:["$","section","What not to delete",{"className":"seo-page__section","children":[["$","h2",null,{"children":"What not to delete"}],["$","p",null,{"children":"System files, Windows Update caches, and software installers can look like duplicates but aren't safe to remove. Stick to user files: photos, videos, music, documents, downloads. A proper duplicate finder compares content byte-by-byte, so you're never guessing."}]]}]
5:["$","ol",null,{"className":"seo-page__steps","children":[["$","li","0",{"children":[["$","h3",null,{"children":"Scan your largest folders first"}],["$","p",null,{"children":"Start with Downloads, Pictures, and Videos — these accumulate the most duplicates. Duplicate Finder hashes every file by content, not name, so it catches copies even if they've been renamed or moved."}]]}],["$","li","1",{"children":[["$","h3",null,{"children":"See exactly how much space you'll recover"}],["$","p",null,{"children":"Before you do anything, Duplicate Finder shows you the total recoverable space across all duplicate groups. You'll know exactly what you're about to free up."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Remove safely via Recycle Bin"}],["$","p",null,{"children":"Every file goes to the Recycle Bin, not permanent deletion. If something turns out to be important, restore it immediately."}]]}]]}]
