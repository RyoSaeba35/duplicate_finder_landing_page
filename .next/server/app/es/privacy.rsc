6:["$","div",null,{"className":"wrap","style":{"maxWidth":720,"padding":"56px 24px 80px"},"children":[["$","a",null,{"href":"/es","style":{"fontSize":14,"color":"var(--teal)"},"children":"← Volver al inicio"}],["$","h1",null,{"className":"mono","style":{"fontSize":28,"marginTop":24,"marginBottom":4},"children":"Privacy Policy"}],["$","div",null,{"style":{"fontSize":13,"color":"var(--ink-faint)","marginBottom":24},"children":"Last updated: July 2026"}],["$","div",null,{"style":{"background":"var(--panel-raised)","border":"1px solid var(--border)","borderRadius":"var(--radius)","padding":"12px 16px","fontSize":14,"color":"var(--ink-dim)","marginBottom":28},"children":"Este documento solo está disponible en inglés. En caso de ambigüedad o error de traducción, prevalece la versión en inglés."}],["$","p",null,{"style":{"fontSize":15,"color":"var(--ink-dim)","lineHeight":1.6,"marginBottom":36},"children":"This is a short policy because Duplicate Finder doesn't collect much. Here's exactly what happens to your data, and what doesn't."}],[["$","section","The app itself",{"style":{"marginBottom":28},"children":[["$","h2",null,{"style":{"fontSize":17,"marginBottom":10},"children":"The app itself"}],[["$","p","0",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"Duplicate Finder runs entirely on your own computer. It does not send your files, file names, folder paths, or scan results anywhere — not to us, not to any third party. There is no telemetry, no analytics, and no \"phone home\" behavior of any kind built into the software."}],["$","p","1",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"Your license key and trial status are stored in a local file on your own machine (under your Windows user profile). We never see this information; it never leaves your computer."}],["$","p","2",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"Files you choose to delete are moved to your operating system's Recycle Bin, using the normal Windows mechanism — the same as deleting a file in File Explorer."}]]]}],["$","section","This website",{"style":{"marginBottom":28},"children":[["$","h2",null,{"style":{"fontSize":17,"marginBottom":10},"children":"This website"}],[["$","p","0",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"This site is a set of static pages with no accounts, forms, or tracking scripts. Our hosting provider may keep standard server access logs (such as IP address and browser type) as a normal part of operating any website — we don't have a separate analytics or advertising script collecting this ourselves."}]]]}],["$","section","Purchases",{"style":{"marginBottom":28},"children":[["$","h2",null,{"style":{"fontSize":17,"marginBottom":10},"children":"Purchases"}],[["$","p","0",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"Payments are handled entirely by Gumroad, a third-party payment processor. When you buy a license, Gumroad collects your email address and payment details under its own privacy policy — we recommend reading it at gumroad.com/privacy."}],["$","p","1",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"We (the developer) only receive your email address and confirmation that a sale occurred, which we use to send you a license key. We do not receive or store your payment card details at any point."}]]]}],["$","section","Cookies",{"style":{"marginBottom":28},"children":[["$","h2",null,{"style":{"fontSize":17,"marginBottom":10},"children":"Cookies"}],[["$","p","0",{"style":{"fontSize":14.5,"color":"var(--ink-dim)","lineHeight":1.65,"marginBottom":10},"children":"This site does not currently use cookies or tracking scripts. If that changes in the future (for example, adding basic analytics), this policy will be updated accordingly."}]]]}],["$","section","Contact",{"style":{"marginBottom":28},"children":["$L12",["$L13"]]}]]]}]
