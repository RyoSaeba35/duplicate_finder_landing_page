5:["$","section","Why duplicates accumulate faster than you think",{"className":"seo-page__section","children":[["$","h2",null,{"children":"Why duplicates accumulate faster than you think"}],["$","p",null,{"children":"Every time you drag a file instead of moving it, download something you already have, or run overlapping backups — you create duplicates. A 1 TB drive can easily waste 20–30 GB on identical files. Windows Explorer only shows file names, not whether the content is actually identical to something else on your system."}]]}]
6:["$","section","Why manual search isn't enough",{"className":"seo-page__section","children":[["$","h2",null,{"children":"Why manual search isn't enough"}],["$","p",null,{"children":"Searching for files with the same name only catches obvious cases. Files can be renamed, moved to different folders, or have different timestamps — and still be byte-for-byte identical. You need a tool that compares file content, not just names."}]]}]
7:["$","ol",null,{"className":"seo-page__steps","children":[["$","li","0",{"children":[["$","h3",null,{"children":"Choose a folder or your entire drive"}],["$","p",null,{"children":"Point Duplicate Finder at a specific folder (Downloads, Documents, Pictures) or scan your entire C:\\ drive. The app hashes every file by actual content — not name or size."}]]}],["$","li","1",{"children":[["$","h3",null,{"children":"Review duplicates side by side"}],["$","p",null,{"children":"Every duplicate group shows both copies with location, size, and modification date. For images and documents, you get a live preview — so you see exactly what you're looking at before deciding anything."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Send copies to the Recycle Bin"}],["$","p",null,{"children":"Mark the copies you don't need. Duplicate Finder moves them to the Windows Recycle Bin — never a permanent deletion. If you change your mind, restore them instantly."}]]}]]}]
8:["$","section",null,{"className":"seo-page__faq","children":[["$","h2",null,{"children":"Frequently asked questions"}],[["$","div","Can it accidentally delete files I need?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"Can it accidentally delete files I need?"}],["$","p",null,{"children":"No. Duplicate Finder only marks files you explicitly select, after you've compared them side by side. Every deletion goes to the Windows Recycle Bin — nothing is ever permanently deleted by the app itself."}]]}],["$","div","Does it find duplicates across different drives?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"Does it find duplicates across different drives?"}],["$","p",null,{"children":"Yes — you can scan any folder or drive, including external USB drives and network locations accessible from Windows Explorer."}]]}],["$","div","What if files have different names but identical content?",{"className":"seo-page__faq-item","children":[["$","h3",null,{"children":"What if files have different names but identical content?"}],["$","p",null,{"children":"That's exactly what it's designed for. Duplicate Finder hashes file content byte-by-byte, so renamed copies are detected just as reliably as exact-name matches."}]]}]]]}]
